use Getopt::Std;
use File::Basename;

getopts('d')  ;

my $LAZYDIR = "/data/experiment/mu3e/data/2026/lazy";
my $RUNRAWDATA = "/data/experiment/mu3e/data/2026/raw/";

# ---------------------------------------------------------------------
# fuser exits 0 while some process still has the file open.
sub file_is_open {
  my $path = shift;
  system("fuser", "-s", $path);
  return 0 if $? == -1;
  return ($? >> 8) == 0;
}

# Size and mtime were sampled before a short wait. A writer still
# appending moves one of them; a paused local writer is still open.
sub file_is_closed {
  my ($path, $before) = @_;
  return 0 if file_is_open($path);
  my ($size, $mtime) = (stat($path))[7, 9];
  return 0 unless defined $size && defined $before && defined $before->[0];
  return $size == $before->[0] && $mtime == $before->[1];
}

# ---------------------------------------------------------------------
sub getLazyFiles {
  my $lazyDir = shift;
  opendir(my $dh, $lazyDir) or die "Cannot open $lazyDir: $!\n";
  my @names = grep { $_ ne '.' && $_ ne '..' && ($_ =~ /\.json$/ || $_ =~ /\.mid.lz4$/) } readdir($dh);
  closedir($dh);

  my @ready;
  my @pending;
  for my $file (@names) {
    my $rawFile = $RUNRAWDATA . getRawSubDir($file) . "/" . $file;
    if (-f $rawFile) {
      push @ready, $file;
    } else {
      push @pending, $file;
    }
  }

  my %stamp;
  for my $file (@pending) {
    $stamp{$file} = [ (stat("$lazyDir/$file"))[7, 9] ];
  }
  sleep 2 if @pending;

  for my $file (@pending) {
    my $path = "$lazyDir/$file";
    if (!file_is_closed($path, $stamp{$file})) {
      print "skip $file, not yet closed\n";
      next;
    }
    push @ready, $file;
  }
  @ready = sort { $b cmp $a } @ready;
  return @ready;
}

# ---------------------------------------------------------------------
sub getRawSubDir {
  my $file = shift;
  my ($run) = $file =~ /(\d+)/;
  my $rawSubDir = sprintf("%03d", $run / 1000);
  return $rawSubDir;
}


# ---------------------------------------------------------------------
my @lazyFiles = getLazyFiles($LAZYDIR);
my $count = 0;
foreach my $file (@lazyFiles) {
  my $rawSubDir = getRawSubDir($file);
  my $rawDir = $RUNRAWDATA . $rawSubDir;
  if (! -d $rawDir) {
    print "Raw directory $rawDir does not exist, create it\n";
    mkdir $rawDir, 0755;
  }
  my $rawFile = $rawDir . "/" . $file;
  if (! -f $rawFile) {
    if ($count == 0) {
      print "updateDataFromLazy executed at ". localtime, "\n";
    }
    print "Raw file $rawFile does not exist, copy it\n";
    if ($opt_d) {
      print "cp -p $LAZYDIR/$file $rawFile\n";
    } else {
      system("cp -p $LAZYDIR/$file $rawFile");
    }
    $count++;
  }
}
if ($count > 0) {
  print "Found ". scalar(@lazyFiles) . " lazy files and copied ". $count . " raw files\n";
} else {
  print "updateDataFromLazy executed at ". localtime, ", nothing to do\n";
}

