use Getopt::Std;
use File::Basename;

getopts('df:n:r:');


print "updateRunDB executed at ". localtime, "\n";

my $RDBURL = "http://mu3edb0/rdb/runrecords";
my $RDBADDURL = "http://mu3edb0/rdb/addAttribute";
my $RUNLOGDIR = "/home/mu3e/online/message/runlogs";
my $ATTRDIR = "/home/ursl/mu3e/software/mu3eanca/db1/rest";
my $RUNSDONE = "/home/ursl/mu3e/software/mu3eanca/runs.txt";
my $RUNSFAIL = "/home/ursl/mu3e/software/mu3eanca/runs.fail";
my $RUNSIGNORE = "/home/ursl/mu3e/software/mu3eanca/runs.ignore";
my $FAILMAX = 3;
my $LAST = 100;

my $singleRun = -1;
if ($opt_r) {
    $singleRun = $opt_r;
}


# -- last $LAST lines of runs already done, read from the end of the file
print("reading $LAST lines from $RUNSDONE\n");
open(IN, "$RUNSDONE") || die "updateRunDB: Cannot open $RUNSDONE\n";
seek(IN, 0, 2);
my $pos = tell(IN);
my $buf = "";
my $nl = 0;
while ($pos > 0 && $nl <= $LAST) {
    my $n = ($pos >= 4096) ? 4096 : $pos;
    $pos -= $n;
    seek(IN, $pos, 0) || die "updateRunDB: Cannot seek $RUNSDONE\n";
    my $read = "";
    read(IN, $read, $n);
    $buf = $read . $buf;
    $nl = ($buf =~ tr/\n/\n/);
}
close(IN);
my @runsdone = split(/\n/, $buf);
shift @runsdone if $pos > 0;
@runsdone = splice(@runsdone, -$LAST) if @runsdone > $LAST; 

# -- runs.fail: "runlog_NNNNN.json <count>", last line for a run wins
my %failcount;
if (-f $RUNSFAIL) {
    print("reading $RUNSFAIL\n");
    open(IN, "$RUNSFAIL") || die "updateRunDB: Cannot open $RUNSFAIL\n";
    while (<IN>) {
        chop($_);
        next unless /^(\S+)\s+(\d+)$/;
        $failcount{$1} = $2;
    }
    close(IN);
}

# -- blacklist: same names as runs.txt, one runlog file per line
my @runsignore;
if (-f $RUNSIGNORE) {
    print("reading $RUNSIGNORE\n");
    open(IN, "$RUNSIGNORE") || die "updateRunDB: Cannot open $RUNSIGNORE\n";
    while (<IN>) {
        chop($_);
        next if $_ eq "";
        push @runsignore, $_;
    }
    close(IN);
}

# -- read runlog file(names)
print("reading $RUNLOGDIR\n");
opendir(RNLG, "$RUNLOGDIR") ||  die "Cannot read $RUNLOGDIR\n";
@filelist = sort(grep(/\.json$/,readdir(RNLG)));
print("found ". scalar(@filelist) . " runlog files\n");
if (@filelist > $LAST) {
    print("limiting to last $LAST runlog files\n");
    @filelist = @filelist[-$LAST .. -1];
}
@runsToDo = (); 
if ($opt_f && $opt_f == $d) {
    push @runsToDo, $d;
} else {
    my @stringd;
    my $goodFile; 
    foreach $d (@filelist) {
        #  print "->$d\n";
        my $ignored = grep { $_ eq $d } @runsignore;
        my $nfail = $failcount{$d} || 0;
        if ($nfail >= $FAILMAX && !$ignored) {
            open(IGN, ">>$RUNSIGNORE") || die "updateRunDB: Cannot open $RUNSIGNORE for output\n";
            print IGN "$d\n";
            close(IGN);
            push @runsignore, $d;
            $ignored = 1;
            print("blacklisted $d after $nfail unsuccessful uploads\n");
        }
        if (grep(/$d/, @runsdone) || $ignored) {
        } else {
            # -- check that this runlog is already complete
            @stringd = ();
            $goodFile = 0;     
            open(IND,  "$RUNLOGDIR/$d") || die "updateRunDB: Cannot open $RUNLOGDIR/$d\n";
            while(<IND>) {
                chop($_);
                push(@stringd, $_);
            }
            close(IND);
            $clos = pop(@stringd);
            if ((grep(/EOR/, @stringd)) && ($clos eq '}')) {
                $goodFile = 1;     
                print("found all for $d, will add to runsToDo\n");
            } elsif  ($clos =~ /\},/) {
                # print("incomplete file for $d\n");
            } else {
                # print("missing something else ->$clos<-\n");
                # print("$stringd\n");
            }
            # print "  .. ->$d<- added to runsToDo\n";
            if ($goodFile == 1) {push @runsToDo, $d;}
        }
    }
}
closedir RNLG;

my $cnt = 0; 
print("processing ". scalar(@runsToDo) . " runlog files\n");
foreach $d (@runsToDo) {

    my $runno = $d;
    $runno =~ s/\.json$//;
    $runno =~ s/^runlog_//;
    $runno = int($runno);

    if ($singleRun > -1 && $runno != $singleRun) {
        next;
    }

    print("updateRunDB for record ->$d<-\n");
    if ($opt_n && $cnt == $opt_n) {
        exit;
    }

    my $dqFile = "$ATTRDIR/dqTemplate.json";
    my $riFile = "$ATTRDIR/runInfoTemplate.json";

    $now_string = localtime; 

    if ($opt_d) {
        print("dbx: curl -X PUT -H \"Content-Type: application/json\" --data-binary \@$RUNLOGDIR/$d $RDBURL\n");
    } else {
        my $tcnt = 0; 
        my $res = 1;
        while (($tcnt < 10) && ($res != 0)) {
            $res = `curl -X PUT -H \"Content-Type: application/json\" --data-binary \@$RUNLOGDIR/$d $RDBURL`;
            print("res ->$res<-\n");
            $tcnt++;
        }
        if ($res eq "Uh oh! An unexpected error occured.") {
            print("  transfer unsuccessful?! $d   $now_string\n");
            my $nfail = ($failcount{$d} || 0) + 1;
            $failcount{$d} = $nfail;
            open(FAIL, ">>$RUNSFAIL") || die "updateRunDB: Cannot open $RUNSFAIL for output\n";
            print FAIL "$d $nfail\n";
            close(FAIL);
            print("  unsuccessful uploads for $d: $nfail\n");
            if ($nfail >= $FAILMAX) {
                open(IGN, ">>$RUNSIGNORE") || die "updateRunDB: Cannot open $RUNSIGNORE for output\n";
                print IGN "$d\n";
                close(IGN);
                push @runsignore, $d;
                print("  blacklisted $d after $nfail unsuccessful uploads\n");
            }
            system("cat $RUNLOGDIR/$d");
            print("end file\n");
        } elsif ($opt_f && $opt_f == $d) {
            print("  transfer successful! $d $now_string  Adding attributes\n");
            system("curl -X PUT -H \"Content-Type: application/json\" --data-binary \@$dqFile $RDBADDURL/$runno");
            system("curl -X PUT -H \"Content-Type: application/json\" --data-binary \@$riFile $RDBADDURL/$runno"); 
        } else {
            print("  transfer successful! $d $now_string  Adding attributes\n");
            #print("curl -X PUT -H \"Content-Type: application/json\" --data-binary \@$dqFile $RDBADDURL/$runno\n");
            #print("curl -X PUT -H \"Content-Type: application/json\" --data-binary \@$riFile $RDBADDURL/$runno\n"); 
            system("curl -X PUT -H \"Content-Type: application/json\" --data-binary \@$dqFile $RDBADDURL/$runno");
            system("curl -X PUT -H \"Content-Type: application/json\" --data-binary \@$riFile $RDBADDURL/$runno"); 
            open(IN,  ">>$RUNSDONE") || die "updateRunDB: Cannot open $RUNSDONE for output\n";
            print IN "$d\n";
            close(IN);
        }
    }
    $cnt++;
}
