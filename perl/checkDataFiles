use strict;

use Getopt::Std;
use File::Basename;

getopts('l:r:');

my $rawdir = $opt_r;
my $lazydir = $opt_l;

my @rawfiles = glob("$rawdir/*.mid.lz4");

@rawfiles = sort @rawfiles;

print "Checking $rawdir and $lazydir\n";

foreach my $rawfile (@rawfiles) {
  my $lazyfile = $rawfile;
  $lazyfile =~ s/$rawdir/$lazydir/;
  my $lsize = -s $lazyfile;
  my $rsize = -s $rawfile;
  my $mismatch = "";
  if ($lsize != $rsize) {
    $mismatch = "*************";
  }
  print $rawfile, "-> $lazyfile ($lsize, $rsize) $mismatch\n";
}