#! /usr/bin/perl

# ----------------------------------------------------------------------
# prompt — 2026 prompt production (prompt0)
#
#   ./prompt setup
#   ./prompt init
#   ./prompt bootstrap          # setup + init
#   ./prompt [-P beam] run 12345
#   ./prompt [-P beam] process 10482   # that run, every later raw file, then sleep
#   ./prompt processEven 10482        # same scan, only even run numbers
#   ./prompt processOdd  10482        # same scan, only odd run numbers
#   ./prompt -P dqm pool10 11000      # up to 10 children until mu3esort
#   ./prompt -P dqm prod10 11000      # same pool, then sleep and pick up new runs
#
# Host overlay is host-<platform>.cfg (e.g. host-merlin6.cfg), not
# config-<hostname>.cfg as in startGT / relval.
# ----------------------------------------------------------------------

use strict;
use warnings;

# no_ignore_case: otherwise -H is -h (help) and -p is -P (pipeline).
use Getopt::Long qw(:config no_ignore_case);
use Pod::Usage;

my $config   = "prompt-v7.1.cfg";
my $help     = 0;
my $host_opt = "";
my $dry_run  = 0;
my $jobs     = undef;
my $setup_name = "";
my @packages   = ();
my $pipeline   = "";
my $runs_opt   = "";

# Saved before GetOptions, which removes the flags from @ARGV.
my @invocation = ($0, @ARGV);

GetOptions(
    "c=s"        => \$config,
    "H|host=s"   => \$host_opt,
    "s=s"        => \$setup_name,
    "p=s@"       => \@packages,
    "P=s"        => \$pipeline,
    "r=s"        => \$runs_opt,
    "j=i"        => \$jobs,
    "n"          => \$dry_run,
    "h|help"     => \$help,
) or pod2usage(2);

pod2usage(1) if $help;

use Cwd qw(abs_path);
use File::Basename qw(dirname basename);
use POSIX qw(WNOHANG);
use Fcntl qw(F_GETFL F_SETFL F_SETFD O_NONBLOCK);
use Errno qw(EAGAIN EWOULDBLOCK);

use lib abs_path(dirname($0));
use lib abs_path(dirname($0)) . "/../common";
use ProdConfig qw(load_config);
use Prompt qw(
    prompt_platform
    prompt_apply_area
    prompt_setup
    prompt_init
    prompt_bootstrap
    prompt_status
    prompt_list
    prompt_cleanup
);
use Pipeline qw(pipeline_run);
use TaskLib qw(forward_runs);

sub prefix {
    my $now = localtime;
    return "$now/prompt         / ";
}

# An argument is quoted when it would not be a single tcsh word.
sub _quote_arg {
    my ($s) = @_;
    return $s if $s =~ /^[\w.\/:=@+,~-]+$/;
    $s =~ s/'/'\\''/g;
    return "'$s'";
}

# 11811,11812,11813,11820 -> 11811-11813,11820. @runs must be sorted.
sub _run_ranges {
    my @r = @_;
    return "" unless @r;
    my @parts;
    my $a = $r[0];
    my $b = $r[0];
    for (my $i = 1; $i < @r; $i++) {
        if ($r[$i] == $b + 1) {
            $b = $r[$i];
            next;
        }
        push @parts, ($a == $b) ? $a : "$a-$b";
        $a = $b = $r[$i];
    }
    push @parts, ($a == $b) ? $a : "$a-$b";
    return join(",", @parts);
}

sub usage {
    print <<"END";
Usage: $0 [-c FILE] [-H platform] [-s YYMMDD] [-p ID] [-P PIPE] [-n] [-j N] [target] [RUN ...]

Targets:
  setup          clone/checkout/build/relink [repo] packages
  init           production area: slurm dirs, githashes, payload dir, alignment, tar
  bootstrap      setup then init
  status         paths and build/tar state
  list           print resolved config + packages (default)
  run RUN ...    run the pipeline for each RUN (see -P)
  process RUN    from RUN forward through raw files (010, 011, ...), then sleep and look again
  processEven RUN  same as process, only even run numbers
  processOdd RUN   same as process, only odd run numbers
  poolN RUN      reprocess raw files from RUN up, at most N children until pool_long_from
  prodN RUN      same pool as poolN; keep scanning from RUN, alternate newest and oldest
  cleanup RUN ... remove per-run output (keeps timestamped logs in runs/XXXXX/)

Options:
  -c FILE        config file (default: prompt-v7.1.cfg)
  -H PLATFORM    host overlay host-PLATFORM.cfg (default: merlin6 on merlin-l-*)
  -s YYMMDD      override prompt_workdir (dated production area)
  -p ID          only this [repo] id (setup; repeatable or comma-separated)
  -P PIPE        pipeline alias, tasks, or a mix (default: cfg pipeline:)
  -r RUNS        run numbers: 12345,12346 or 12345..12350 (with run or cleanup)
  -j N           make -jN for package builds
  -n             dry-run
  -h             help
END
    exit(1);
}

sub _opts {
    my %opts = (dry_run => $dry_run ? 1 : 0);
    $opts{jobs} = 0 + $jobs if defined $jobs;
    $opts{setup_name} = $setup_name if $setup_name ne "";
    $opts{repo_ids} = \@packages if @packages;
    $opts{pipeline} = $pipeline if $pipeline ne "";
    return %opts;
}

# 12345..12350 is inclusive. A later bare number cancels the "from a range" mark.
sub _expand_run_spec {
    my ($tok) = @_;
    return ($tok) unless $tok =~ /^(\d+)\.\.(\d+)$/;
    my ($a, $b) = (0 + $1, 0 + $2);
    my $span = abs($b - $a) + 1;
    die "prompt: run range $tok has $span numbers (limit 20000)\n"
        if $span > 20000;
    return $a <= $b ? ($a .. $b) : reverse($b .. $a);
}

sub _collect_runs {
    my ($target, @argv) = @_;
    my @specs;
    if ($runs_opt ne "") {
        push @specs, grep { $_ ne "" } split(/,/, $runs_opt);
    }
    for my $a (@argv) {
        next if $a eq $target;
        next if $a =~ /^-/;
        push @specs, grep { $_ ne "" } split(/,/, $a);
    }
    my @runs;
    my %seen;
    my %from_range;
    for my $spec (@specs) {
        my $is_range = ($spec =~ /^\d+\.\.\d+$/);
        for my $n (_expand_run_spec($spec)) {
            die "prompt: bad run number '$n'\n" unless $n =~ /^\d+$/;
            if ($is_range) {
                $from_range{$n} = 1 unless $seen{$n};
            } else {
                delete $from_range{$n};
            }
            next if $seen{$n}++;
            push @runs, $n;
        }
    }
    return (\@runs, \%from_range);
}

my $script_dir = abs_path(dirname($0));
chdir($script_dir) or die "Cannot chdir to $script_dir: $!\n";

print(prefix(), "pid=$$ ", join(" ", map { _quote_arg($_) } @invocation), "\n");

my $cfg_file = $config;
my $host     = prompt_platform($host_opt);

my $target = "";
for my $a (@ARGV) {
    next if $a =~ /^-/;
    $target = $a;
    last;
}

if ($target eq "") {
    my $peek = load_config($cfg_file, $host);
    $target = $peek->{target} // $peek->{action} // "list";
    $target =~ s/^\s+|\s+$//g;
}
$target = "list" if $target eq "";

my ($pool_mode, $pool_n) = ("", 0);
if ($target =~ /^(pool|prod)(\d+)$/) {
    $pool_mode = $1;
    $pool_n = 0 + $2;
    die "prompt: $target needs a slot count >= 1 (./prompt pool10 11000)\n"
        if $pool_n < 1;
}

my @runs;
my $from_range = {};
if ($target eq "run" || $target eq "cleanup" || $target eq "process"
    || $target eq "processEven" || $target eq "processOdd" || $pool_mode ne "") {
    my ($runlist, $range_mark) = _collect_runs($target, @ARGV);
    @runs = @$runlist;
    $from_range = $range_mark;
}
if ($target eq "process" || $target eq "processEven" || $target eq "processOdd"
    || $pool_mode ne "") {
    die "prompt: $target takes one starting run (./prompt $target 10482)\n"
        unless @runs == 1 && !%$from_range;
}

my $banner = prefix() . "config=$cfg_file host=$host target=$target"
    . ($setup_name ne "" ? " workdir=$setup_name" : "")
    . (@packages ? " packages=" . join(",", @packages) : "")
    . ($pipeline ne "" ? " pipeline=$pipeline" : "")
    . (@runs ? " runs=" . join(",", @runs) : "")
    . ($dry_run ? " (dry-run)" : "");
print($banner, "\n");

my $cfg = load_config($cfg_file, $host);
prompt_apply_area($cfg, _opts());

my %opts = _opts();

if ($target eq "setup") {
    prompt_setup($cfg, %opts);
} elsif ($target eq "init") {
    prompt_init($cfg, %opts);
} elsif ($target eq "bootstrap") {
    prompt_bootstrap($cfg, %opts);
} elsif ($target eq "status") {
    prompt_status($cfg, %opts);
} elsif ($target eq "list") {
    prompt_list($cfg);
} elsif ($target eq "process" || $target eq "processEven" || $target eq "processOdd") {
    my $start = 0 + $runs[0];
    my $pause = 0 + ($cfg->{process_sleep} // 60);
    $pause = 60 if $pause < 1;
    my $want = ($target eq "processEven") ? 0 : ($target eq "processOdd") ? 1 : -1;
    my $hard = 0;
    while (1) {
        my @fwd = forward_runs($cfg, $start);
        my @pick = @fwd;
        @pick = grep { ($_ % 2) == $want } @fwd if $want >= 0;
        if (@pick) {
            print(prefix(), "$target: from $start -> " . join(",", @pick) . "\n");
            $opts{runs} = \@pick;
            $opts{banner} = $banner;
            $hard += pipeline_run($cfg, %opts);
        } elsif (@fwd) {
            my $which = $want == 0 ? "even" : "odd";
            print(prefix(), "$target: no $which runs at or after $start (raw: "
                . join(",", @fwd) . ")\n");
        } else {
            print(prefix(), "$target: no raw files at or after $start\n");
        }
        $start = $fwd[-1] + 1 if @fwd;
        if ($dry_run) {
            print(prefix(), "$target: would sleep ${pause}s and look again\n");
            last;
        }
        print(prefix(), "$target: sleep ${pause}s\n");
        sleep($pause);
    }
    print(prefix(), "done\n");
    exit($hard ? 1 : 0);
} elsif ($pool_mode ne "") {
    my $start = 0 + $runs[0];
    my $pause = 0 + ($cfg->{process_sleep} // 60);
    $pause = 60 if $pause < 1;
    my $prog = "$script_dir/" . basename($0);
    my @queue;
    my %seen;
    my %kids;
    my %long;
    my $hard = 0;
    my $long_from = $cfg->{pool_long_from} // "mu3esort";
    $long_from =~ s/^\s+|\s+$//g;
    $long_from =~ s/^['"]|['"]$//g;
    my ($rd, $wr);
    my $relbuf = "";

    my $child_cmd = sub {
        my ($run) = @_;
        # Host comes from the hostname (merlin-l-* → merlin6). Do not pass -H.
        my @cmd = ($prog, "-c", $cfg_file);
        push @cmd, "-s", $setup_name if $setup_name ne "";
        push @cmd, "-P", $pipeline if $pipeline ne "";
        push @cmd, "run", $run;
        return @cmd;
    };
    my $counts = sub {
        return scalar(keys %kids) . " short, " . scalar(keys %long) . " long";
    };
    my $reap = sub {
        while (1) {
            my $pid = waitpid(-1, WNOHANG);
            last if $pid <= 0;
            my $phase = "short";
            my $run = delete $kids{$pid};
            if (!defined $run) {
                $run = delete $long{$pid};
                $phase = "long";
            }
            my $rc = $? >> 8;
            $rc = 1 if $rc == 0 && ($? & 127);
            my $left = $counts->();
            if (!defined $run) {
                print(prefix(), "$target: reaped pid $pid exit $rc ($left)\n");
                $hard++ if $rc != 0;
                next;
            }
            if ($rc != 0) {
                $hard++;
                print(prefix(), "$target: run $run ($phase) exited $rc ($left)\n");
            } else {
                print(prefix(), "$target: run $run ($phase) done ($left)\n");
            }
        }
    };
    # A child writes its pid when it reaches pool_long_from. That pid
    # leaves the slot count and stays in %long until it exits.
    my $release = sub {
        return unless defined $rd;
        while (1) {
            my $n = sysread($rd, my $chunk, 4096);
            if (!defined $n) {
                last if $! == EAGAIN || $! == EWOULDBLOCK;
                die "prompt: slot pipe: $!\n";
            }
            last if $n == 0;
            $relbuf .= $chunk;
        }
        while ($relbuf =~ s/^(\d+)\n//) {
            my $pid = 0 + $1;
            my $run = delete $kids{$pid};
            next unless defined $run;
            $long{$pid} = $run;
            print(prefix(), "$target: run $run reached $long_from (" . $counts->() . ")\n");
        }
    };
    my $spawn = sub {
        my ($run) = @_;
        my @cmd = $child_cmd->($run);
        print(prefix(), "$target: start " . join(" ", map { _quote_arg($_) } @cmd) . "\n");
        # The child waits until the parent has recorded the pid, so a
        # release cannot arrive before %kids knows about it.
        pipe(my $go_r, my $go_w) or die "prompt: pipe failed: $!\n";
        my $pid = fork();
        die "prompt: fork failed: $!\n" unless defined $pid;
        if ($pid == 0) {
            close $rd if defined $rd;
            close $go_w;
            my $got = sysread($go_r, my $buf, 1);
            close $go_r;
            exit 2 unless $got;
            if (defined $wr && $long_from ne "") {
                fcntl($wr, F_SETFD, 0);
                $ENV{PROMPT_RELEASE_FD} = fileno($wr);
                $ENV{PROMPT_LONG_FROM} = $long_from;
            }
            # The run log (runs/RUN/<stamp>-<pipeline>.log) already records
            # the child. Do not copy that stream onto the prod/pool terminal.
            open STDOUT, ">", "/dev/null" or exit 2;
            open STDERR, ">&STDOUT" or exit 2;
            exec {$cmd[0]} @cmd or die "prompt: exec $cmd[0]: $!\n";
        }
        close $go_r;
        $kids{$pid} = $run;
        my $nw = syswrite($go_w, "x");
        close $go_w;
        if (!$nw) {
            kill 9, $pid;
            delete $kids{$pid};
            die "prompt: failed to start run $run: $!\n";
        }
    };
    my $wait_io = sub {
        my ($timeout) = @_;
        return unless defined $rd;
        my $rin = "";
        vec($rin, fileno($rd), 1) = 1;
        select($rin, undef, undef, $timeout);
    };
    my $take_newest = 1;
    my $discover = sub {
        # Always from the original start. A run that appears later in a
        # gap below the highest file already seen is still queued.
        my @fwd = forward_runs($cfg, $start);
        my @added;
        for my $r (@fwd) {
            next if $seen{$r}++;
            push @added, $r;
        }
        if (@added) {
            push @queue, @added;
            @queue = sort { $a <=> $b } @queue;
        }
        return @added;
    };
    # Newest waiting run, then the oldest, and so on.
    my $next_run = sub {
        return undef unless @queue;
        my $run = $take_newest ? pop @queue : shift @queue;
        $take_newest = !$take_newest;
        return $run;
    };

    $discover->();
    if (!@queue && ($pool_mode eq "pool" || $dry_run)) {
        print(prefix(), "$target: no raw files at or after $start\n");
        if ($pool_mode eq "prod") {
            print(prefix(), "$target: would sleep ${pause}s and look again\n");
        }
        print(prefix(), "done\n");
        exit 0;
    }
    my $slot_note = ($long_from ne "") ? "$pool_n slots until $long_from" : "$pool_n slots";
    if (@queue) {
        print(prefix(), "$target: $slot_note, " . scalar(@queue)
            . " waiting: " . _run_ranges(@queue) . "\n");
    }
    if ($dry_run) {
        my @show = @queue;
        if ($pool_mode eq "prod") {
            my $newest = 1;
            while (@show) {
                my $run = $newest ? pop @show : shift @show;
                $newest = !$newest;
                my @cmd = $child_cmd->($run);
                print(prefix(), "$target: would: " . join(" ", map { _quote_arg($_) } @cmd) . "\n");
            }
        } else {
            for my $run (@show) {
                my @cmd = $child_cmd->($run);
                print(prefix(), "$target: would: " . join(" ", map { _quote_arg($_) } @cmd) . "\n");
            }
        }
        if ($pool_mode eq "prod") {
            print(prefix(), "$target: would sleep ${pause}s and look again\n");
        }
        print(prefix(), "done\n");
        exit 0;
    }

    pipe($rd, $wr) or die "prompt: pipe failed: $!\n";
    my $fl = fcntl($rd, F_GETFL, 0);
    fcntl($rd, F_SETFL, $fl | O_NONBLOCK);
    fcntl($wr, F_SETFD, 0);
    # An empty handler makes select return when a child exits, so a slot
    # release and a finished child are both visible without a blocking wait.
    $SIG{CHLD} = sub { };

    if ($pool_mode eq "pool") {
        while (@queue || keys %kids || keys %long) {
            $release->();
            $reap->();
            while (@queue && keys(%kids) < $pool_n) {
                $spawn->(shift @queue);
            }
            last if !@queue && !keys(%kids) && !keys(%long);
            $wait_io->();
        }
        $release->();
        $reap->();
        print(prefix(), "done\n");
        exit($hard ? 1 : 0);
    }

    while (1) {
        $release->();
        $reap->();
        my @added = $discover->();
        if (@added) {
            print(prefix(), "$target: queued " . _run_ranges(@added)
                . " (waiting " . scalar(@queue) . ")\n");
        }
        while (@queue && keys(%kids) < $pool_n) {
            my $run = $next_run->();
            last unless defined $run;
            $spawn->($run);
        }
        if (@queue && keys(%kids) >= $pool_n) {
            $wait_io->();
            next;
        }
        print(prefix(), "$target: waiting for new raw files (" . $counts->() . ")\n");
        print(prefix(), "$target: sleep ${pause}s\n");
        $wait_io->($pause);
    }
} elsif ($target eq "run") {
    $opts{runs} = \@runs;
    $opts{range_runs} = $from_range;
    $opts{banner} = $banner;
    my $hard = pipeline_run($cfg, %opts);
    print(prefix(), "done\n");
    exit($hard ? 1 : 0);
} elsif ($target eq "cleanup") {
    $opts{runs} = \@runs;
    prompt_cleanup($cfg, %opts);
} else {
    die "unknown target '$target'\n";
}

print(prefix(), "done\n");
exit(0);
