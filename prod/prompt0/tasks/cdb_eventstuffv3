#! /usr/bin/perl
# cdb_eventstuffv3 — write the eventstuffv3 payload from the midasmeta JSON.
#
# The JSON is the raw file plus ".json", written by midasmeta:
#   {raw_dir}/011/run11015.mid.lz4.json
# readJSON also reads the sibling ODB file run11015.json (DEFF, LVDE, TDAC).
#
# This step only writes the local payload. IOV insertion and the CDB REST
# upload are not done here.
#
#   cdbRunPayloadWriter -u $CDB -m eventstuffv3 -a $cdb_eventstuffv3_comment -f <json> -t $cdb_eventstuffv3_tag -r RUN
#
# The file is $CDB/payloads/eventstuffv3_<tag>/<block>/tag_eventstuffv3_<tag>_iov_RUN
use strict;
use warnings;
use Cwd qw(getcwd);
use FindBin;
use lib "$FindBin::Bin/..";
use TaskLib;

my ($run, $ctxfile) = TaskLib::args(@ARGV);
my $ctx = TaskLib::load($ctxfile);
my $name = "cdb_eventstuffv3";

my $gt  = $ctx->{cdb_GT} // "";
my $short = $ctx->{cdb_eventstuffv3_tag} // "";
$short = $gt if $short eq "";
my $cdb = $ctx->{cdb_json} // "";
my $raw = $ctx->{raw_file} // TaskLib::raw_file($ctx, $run);
my $json = "$raw.json";
my $anca = $ctx->{mu3eanca} // "";
my $bindir = ($anca ne "") ? "$anca/db0/cdb2/bin" : "";
# bin/* is linked against lib/libCDB.so, resolved from the process cwd.
my $cdbdir = "$bindir/..";

my $comment = $ctx->{cdb_eventstuffv3_comment} // "";
$comment = "prompt" if $comment eq "";
my $payload = "tag_eventstuffv3_${short}_iov_$run";

my @cmd = ($bindir . "/cdbRunPayloadWriter",
    "-u", $cdb, "-m", "eventstuffv3", "-a", $comment,
    "-f", $json, "-t", $short, "-r", $run);

if ($ctx->{dry_run}) {
    TaskLib::task_log($ctx, $name, "would: cd $cdbdir");
    TaskLib::task_log($ctx, $name, "would: @cmd");
    exit 0;
}

if ($short eq "") {
    TaskLib::task_log($ctx, $name, "cdb_eventstuffv3_tag and cdb_GT unset");
    exit 2;
}
if ($cdb eq "" || !-d $cdb) {
    TaskLib::task_log($ctx, $name, "cdb_json missing: $cdb");
    exit 2;
}
if (!-f $json) {
    TaskLib::task_log($ctx, $name, "metadata JSON missing: $json");
    exit 2;
}
if (!-x $cmd[0] && !-f $cmd[0]) {
    TaskLib::task_log($ctx, $name, "program missing: $cmd[0]");
    exit 2;
}

my $cwd = getcwd();
chdir($cdbdir) or do {
    TaskLib::task_log($ctx, $name, "cannot chdir $cdbdir: $!");
    exit 2;
};
TaskLib::task_log($ctx, $name, "cwd=$cdbdir");
TaskLib::task_log($ctx, $name, "@cmd");
my $rc = system(@cmd);
chdir($cwd) or do {
    TaskLib::task_log($ctx, $name, "cannot chdir back to $cwd: $!");
    exit 2;
};
if ($rc != 0) {
    TaskLib::task_log($ctx, $name, "failed ($rc): $cmd[0]");
    exit 2;
}

TaskLib::task_log($ctx, $name, "payload $payload");
exit 0;
