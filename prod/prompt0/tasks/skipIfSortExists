#! /usr/bin/perl
# skipIfSortExists — stop this run when the mu3esort output is already there.
# Exit 1 (soft skip) if sort/{workdir}/{block}/runNNNNN-sorted.root exists.
# Pipeline then does not run the later tasks. ./prompt -f continues anyway.
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/..";
use TaskLib;

my ($run, $ctxfile) = TaskLib::args(@ARGV);
my $ctx = TaskLib::load($ctxfile);
my $name = "skipIfSortExists";

my $sortdir = $ctx->{sort_dir} // "";
if ($sortdir eq "") {
    TaskLib::task_log($ctx, $name, "sort_dir unset");
    exit 2;
}

my $srun = sprintf("%05d", $run);
my $sorted = "$sortdir/" . TaskLib::block_dir($run) . "/run$srun-sorted.root";

if (-f $sorted) {
    if ($ctx->{force}) {
        TaskLib::task_log($ctx, $name, "sort file exists, force set: $sorted");
        exit 0;
    }
    TaskLib::task_log($ctx, $name, "sort file exists, skipping run $run: $sorted");
    exit 1;
}

TaskLib::task_log($ctx, $name, "no sort file: $sorted");
exit 0;
