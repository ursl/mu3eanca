#! /usr/bin/perl
# mu3evertex — SLURM mu3eVertexFit on the mu3etrirec output.
# vertex_n_events <= 0: one job, -n 0 -s 0 (every frame).
# vertex_n_events > 0: jobs of that many frames. The last job uses
# -n 0 so it reads from its skip to the end of the file.
# hadd to vertex/{workdir}/{block}/run{srun}-vertex.root.
# Runs from mu3e/run/ inside the tar.
use strict;
use warnings;
use File::Basename qw(dirname basename);
use FindBin;
use lib "$FindBin::Bin/..";
use TaskLib;
use SlurmBatch;

my ($run, $ctxfile) = TaskLib::args(@ARGV);
my $ctx = TaskLib::load($ctxfile);
my $name = "mu3evertex";

my $srun = sprintf("%05d", $run);
my $block = TaskLib::block_dir($run);
my $trirec = $ctx->{trirec_dir} // "";
my $input = ($trirec ne "") ? "$trirec/$block/run$srun-trirec.root" : "";
my $vertex = $ctx->{vertex_dir} // "";
my $merged = ($vertex ne "") ? "$vertex/$block/run$srun-vertex.root" : "";

if (!-f $input && !$ctx->{dry_run}) {
    TaskLib::task_log($ctx, $name, "trirec file missing: $input");
    exit 2;
}

my $chunk = 0 + ($ctx->{vertex_n_events} // 2000000);
$chunk = 0 if $chunk < 0;
# n_frames is mu3e->GetEntries. A previous task may have counted the sort
# file; the trirec file is the one this job reads.
my $total = 0 + ($ctx->{n_frames} // 0);
if ($chunk > 0 && $total < 1 && -f $input) {
    $total = TaskLib::mu3e_entries($ctx, $input);
    TaskLib::ctx_set($ctxfile, n_frames => $total);
}
TaskLib::task_log($ctx, $name, "trirec=$input chunk=$chunk total=$total");
my $extra = $ctx->{vertex_anlzr} // "";
$extra =~ s/^\s+|\s+$//g;

my $storage1 = "$ctx->{root}/slurm/storage1/vertex";
my $cdb = $ctx->{cdb_dbconn} // "";

my $rc = SlurmBatch::run($ctx, {
    name    => $name,
    stage   => "vertex",
    abbr    => "v",
    wrapper => $ctx->{slurm_vertex_csh},
    total   => $total,
    chunk   => $chunk,
    skip_if => $merged,
    env     => [
        [ STORAGE1   => $storage1 ],
        [ TRIRECDIR  => dirname($input) ],
        [ TRIRECFILE => basename($input) ],
        [ RUN        => $run ],
        [ GT         => $ctx->{cdb_GT} ],
        [ CDB        => $cdb ],
    ],
    job_env => sub {
        my ($j) = @_;
        my $n = ($chunk < 1 || $j->{last}) ? 0 : $chunk;
        my $anl = "-s $j->{skip} -n $n";
        $anl .= " $extra" if $extra ne "";
        return [
            [ ROOTFILE => "vertex-run$j->{job}.root" ],
            [ ANLZR    => $anl ],
        ];
    },
    merge => sub {
        my ($c, $m) = @_;
        return if $merged eq "";
        my @in;
        for my $job (@{ $m->{jobs} }) {
            push @in, "$m->{storage}/vertex-run$job.root";
        }
        SlurmBatch::hadd($c, $name, $merged, @in) or exit 2;
    },
});

exit($rc == 0 ? 0 : 2);
