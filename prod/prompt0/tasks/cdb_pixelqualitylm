#! /usr/bin/perl
# cdb_pixelqualitylm — pixelqualitylm payload for this run.
#
# fillQualityPixels writes the payload file. It is run from run2026 so the
# relative libAnaUtil / libCDB links resolve, and so csv/ is created there.
#
#   fillQualityPixels -g $cdb_GT -t $cdb_pixelqualitylm_tag -j $CDB -d $CDB/payloads \
#     -f $data_dir/mlzr/$prompt_workdir/XXX/dqm_histos_RUN.root \
#     -r $data_dir/raw/XXX/runRUN.mid.lz4.json
#
# -t is the short tag (datav7.1=2026V0). fillQualityPixels writes
# payloads/pixelqualitylm_<tag>/<block>/tag_pixelqualitylm_<tag>_iov_<run>.
# -g is cdb_GT, the global tag used to read the CDB.
#
# Upload, same shape as cdb_eventstuffv2. Not run; cwd for these is db0/cdb2.
#   cdbInsertIovTag -j $CDB -t pixelqualitylm_$cdb_pixelqualitylm_tag -i RUN
#   syncMu3eDB0 --dir $CDB --host $cdb_dbconn --sync payload --name tag_pixelqualitylm_${tag}_iov_RUN --del
#   syncMu3eDB0 --dir $CDB --host $cdb_dbconn --sync tag     --name pixelqualitylm_$cdb_pixelqualitylm_tag --del
use strict;
use warnings;
use Cwd qw(getcwd);
use FindBin;
use lib "$FindBin::Bin/..";
use TaskLib;

my ($run, $ctxfile) = TaskLib::args(@ARGV);
my $ctx = TaskLib::load($ctxfile);
my $name = "cdb_pixelqualitylm";

my $gt  = $ctx->{cdb_GT} // "";
my $tag = $ctx->{cdb_pixelqualitylm_tag} // "";
$tag = $gt if $tag eq "";
# fillQualityPixels stores the file under pixelqualitylm_<short tag>.
my $iovtag  = "pixelqualitylm_$tag";
my $payload = "tag_${iovtag}_iov_$run";
my $cdb = $ctx->{cdb_json} // "";
$cdb =~ s{/$}{};
my $raw = $ctx->{raw_file} // TaskLib::raw_file($ctx, $run);
my $json = "$raw.json";
my $anca = $ctx->{mu3eanca} // "";
my $srun = sprintf("%05d", $run);
my $block = TaskLib::block_dir($run);
my $mlzr = $ctx->{mlzr_dir} // "";
my $root = ($mlzr ne "") ? "$mlzr/$block/dqm_histos_$srun.root" : "";

my $rundir = ($anca ne "") ? "$anca/run2026" : "";
my $exe = ($rundir ne "") ? "$rundir/bin/fillQualityPixels" : "";

my $bindir = ($anca ne "") ? "$anca/db0/cdb2/bin" : "";
my $cdbdir = "$bindir/..";
my $rest = "http://mu3edb0/cdb";
my $dbc = $ctx->{cdb_dbconn} // "";
if ($dbc =~ m{^https?://}) {
    $rest = $dbc;
    $rest =~ s{/$}{};
} elsif (($ctx->{rdb_url} // "") =~ m{^(https?)://([^/:]+)}) {
    $rest = "$1://$2/cdb";
}

my @cmd = (
    $exe,
    "-g", $gt, "-t", $tag, "-j", $cdb, "-d", "$cdb/payloads",
    "-f", $root, "-r", $json,
);

# Upload, not executed. Uncomment @upload and run it from $cdbdir
# (those binaries load lib/libCDB.so from the cwd).
# my @upload = (
#     [$bindir . "/cdbInsertIovTag",
#         "-j", $cdb, "-t", $iovtag, "-i", $run],
#     [$bindir . "/syncMu3eDB0",
#         "--dir", $cdb, "--host", $rest, "--sync", "payload", "--name", $payload, "--del"],
#     [$bindir . "/syncMu3eDB0",
#         "--dir", $cdb, "--host", $rest, "--sync", "tag", "--name", $iovtag, "--del"],
# );

if ($ctx->{dry_run}) {
    TaskLib::task_log($ctx, $name, "would: cd $rundir");
    TaskLib::task_log($ctx, $name, "would: @cmd");
    TaskLib::task_log($ctx, $name, "upload commented out: cd $cdbdir");
    TaskLib::task_log($ctx, $name,
        "upload commented out: $bindir/cdbInsertIovTag -j $cdb -t $iovtag -i $run");
    TaskLib::task_log($ctx, $name,
        "upload commented out: $bindir/syncMu3eDB0 --dir $cdb --host $rest --sync payload --name $payload --del");
    TaskLib::task_log($ctx, $name,
        "upload commented out: $bindir/syncMu3eDB0 --dir $cdb --host $rest --sync tag --name $iovtag --del");
    exit 0;
}

if ($gt eq "") {
    TaskLib::task_log($ctx, $name, "cdb_GT unset");
    exit 2;
}
if ($cdb eq "" || !-d $cdb) {
    TaskLib::task_log($ctx, $name, "cdb_json missing: $cdb");
    exit 2;
}
if ($rundir eq "" || !-d $rundir) {
    TaskLib::task_log($ctx, $name, "run2026 missing: $rundir");
    exit 2;
}
if (!-x $exe && !-f $exe) {
    TaskLib::task_log($ctx, $name, "program missing: $exe");
    exit 2;
}
if ($root eq "" || !-f $root) {
    TaskLib::task_log($ctx, $name, "minalyzer ROOT missing: $root");
    exit 2;
}
if (!-f $json) {
    TaskLib::task_log($ctx, $name, "metadata JSON missing: $json");
    exit 2;
}

my $cwd = getcwd();
chdir($rundir) or do {
    TaskLib::task_log($ctx, $name, "cannot chdir $rundir: $!");
    exit 2;
};
TaskLib::task_log($ctx, $name, "cwd=$rundir");
TaskLib::task_log($ctx, $name, "@cmd");
my $rc = system(@cmd);
chdir($cwd) or do {
    TaskLib::task_log($ctx, $name, "cannot chdir back to $cwd: $!");
    exit 2;
};
if ($rc != 0) {
    TaskLib::task_log($ctx, $name, "failed ($rc): $exe");
    exit 2;
}

exit 0;
