#! /usr/bin/perl
# cdb_pixelqualitylm — upload the pixelqualitylm payload for this run.
#
# fillQualityPixels has already written
#   payloads/pixelqualitylm_<tag>/<block4>/tag_pixelqualitylm_<tag>_iov_<run>
# with <tag> = cdb_pixelqualitylm_tag. This task inserts the IOV and uploads
# the payload and the tag. cwd is db0/cdb2 (lib/libCDB.so).
#
#   cdbInsertIovTag -j $CDB -t pixelqualitylm_$cdb_pixelqualitylm_tag -i RUN
#   syncMu3eDB0 --dir $CDB --host $cdb_dbconn --sync payload --name tag_pixelqualitylm_${tag}_iov_RUN --del
#   syncMu3eDB0 --dir $CDB --host $cdb_dbconn --sync tag     --name pixelqualitylm_$cdb_pixelqualitylm_tag --del
use strict;
use warnings;
use Cwd qw(getcwd);
use FindBin;
use lib "$FindBin::Bin/..";
use TaskLib;

my ($run, $ctxfile) = TaskLib::args(@ARGV);
my $ctx = TaskLib::load($ctxfile);
my $name = "cdb_pixelqualitylm";

my $gt  = $ctx->{cdb_GT} // "";
my $tag = $ctx->{cdb_pixelqualitylm_tag} // "";
$tag = $gt if $tag eq "";
my $iovtag  = "pixelqualitylm_$tag";
my $payload = "tag_${iovtag}_iov_$run";
my $cdb = $ctx->{cdb_json} // "";
$cdb =~ s{/$}{};
my $block4 = sprintf("%04d", int($run / 1000));
my $payload_file = "$cdb/payloads/$iovtag/$block4/$payload";

my $anca = $ctx->{mu3eanca} // "";
my $bindir = ($anca ne "") ? "$anca/db0/cdb2/bin" : "";
my $cdbdir = "$bindir/..";
my $rest = "http://mu3edb0/cdb";
my $dbc = $ctx->{cdb_dbconn} // "";
if ($dbc =~ m{^https?://}) {
    $rest = $dbc;
    $rest =~ s{/$}{};
} elsif (($ctx->{rdb_url} // "") =~ m{^(https?)://([^/:]+)}) {
    $rest = "$1://$2/cdb";
}

my @steps = (
    [$bindir . "/cdbInsertIovTag",
        "-j", $cdb, "-t", $iovtag, "-i", $run],
    [$bindir . "/syncMu3eDB0",
        "--dir", $cdb, "--host", $rest, "--sync", "payload", "--name", $payload, "--del"],
    [$bindir . "/syncMu3eDB0",
        "--dir", $cdb, "--host", $rest, "--sync", "tag", "--name", $iovtag, "--del"],
);

if ($ctx->{dry_run}) {
    TaskLib::task_log($ctx, $name, "would: cd $cdbdir");
    for my $cmd (@steps) {
        TaskLib::task_log($ctx, $name, "would: @$cmd");
    }
    exit 0;
}

if ($tag eq "") {
    TaskLib::task_log($ctx, $name, "cdb_pixelqualitylm_tag and cdb_GT unset");
    exit 2;
}
if ($cdb eq "" || !-d $cdb) {
    TaskLib::task_log($ctx, $name, "cdb_json missing: $cdb");
    exit 2;
}
if (!-f $payload_file) {
    TaskLib::task_log($ctx, $name, "payload missing: $payload_file");
    exit 2;
}
for my $exe (map { $_->[0] } @steps) {
    if (!-x $exe && !-f $exe) {
        TaskLib::task_log($ctx, $name, "program missing: $exe");
        exit 2;
    }
}

my $cwd = getcwd();
chdir($cdbdir) or do {
    TaskLib::task_log($ctx, $name, "cannot chdir $cdbdir: $!");
    exit 2;
};
TaskLib::task_log($ctx, $name, "cwd=$cdbdir");

for my $cmd (@steps) {
    TaskLib::task_log($ctx, $name, "@$cmd");
    my $rc = system(@$cmd);
    if ($rc != 0) {
        chdir($cwd);
        TaskLib::task_log($ctx, $name, "failed ($rc): $cmd->[0]");
        exit 2;
    }
}

chdir($cwd) or do {
    TaskLib::task_log($ctx, $name, "cannot chdir back to $cwd: $!");
    exit 2;
};

exit 0;
