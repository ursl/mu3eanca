#! /usr/bin/perl
# mu3etrirec — SLURM mu3eTrirec (processRuns submitJobsRawTrirec).
# Not ported yet. Use SlurmBatch::run (same as minalyzer, with event splitting).
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/..";
use TaskLib;

my ($run, $ctxfile) = TaskLib::args(@ARGV);
my $ctx = TaskLib::load($ctxfile);
my $file = TaskLib::raw_file($ctx, $run);

TaskLib::task_log($ctx, "mu3etrirec",
    "run $run file=$file  (submitJobsRawTrirec not ported)");

exit 0 if $ctx->{dry_run};
exit 2;
