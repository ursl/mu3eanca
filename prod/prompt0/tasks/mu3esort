#! /usr/bin/perl
# mu3esort — SLURM mu3eSort, one job per run (no event splitting).
# Output run{srun}-sorted.root under sort/{workdir}/{block}/.
# Runs from mu3e/run/ inside the tar (alignment ROOT lives there).
use strict;
use warnings;
use File::Basename qw(dirname basename);
use FindBin;
use lib "$FindBin::Bin/..";
use TaskLib;
use SlurmBatch;

my ($run, $ctxfile) = TaskLib::args(@ARGV);
my $ctx = TaskLib::load($ctxfile);
my $name = "mu3esort";

my $file = TaskLib::raw_file($ctx, $run);
my $srun = sprintf("%05d", $run);
my $block = TaskLib::block_dir($run);

# Output under {data_dir}/sort/{workdir}/{block}/.
# block = run/1000 as 3 digits (same as mlzr/trirec).
my $sortdir = $ctx->{sort_dir} // "";
my $sorted = ($sortdir ne "") ? "$sortdir/$block/run$srun-sorted.root" : "";

if (!-f $file && !$ctx->{dry_run}) {
    TaskLib::task_log($ctx, $name, "raw file missing: $file");
    exit 2;
}

if (!$ctx->{force} && $sorted ne "" && -f $sorted) {
    TaskLib::task_log($ctx, $name, "sorted file already exists, skipping");
    exit 0;
}

my $storage1 = "$ctx->{root}/slurm/storage1/sort";
my $datadir  = dirname($file);
my $midas    = basename($file);

# conf file selection: prefer sort_conf from cfg, else default beam conf.
my $anlzr = $ctx->{sort_anlzr}
    // "--alignment.file=mu3e_alignment.root --conf trirec_threelayer_beam.conf ";
$anlzr =~ s/\s+$//;

my $rc = SlurmBatch::run($ctx, {
    name    => $name,
    stage   => "sort",
    abbr    => "s",
    wrapper => $ctx->{slurm_sort_csh},
    njobs   => 1,
    env     => [
        [ STORAGE1  => $storage1 ],
        [ DATADIR   => $datadir ],
        [ MIDASFILE => $midas ],
        [ RUN       => $run ],
        [ GT        => $ctx->{cdb_GT} ],
    ],
    job_env => sub {
        my ($j) = @_;
        return [
            [ ANLZR => $anlzr ],
            [ SORTEDFILE => "sorted-run$j->{job}.root" ],
        ];
    },
    merge => sub {
        my ($c, $m) = @_;
        return if $sorted eq "";
        require File::Path;
        require File::Copy;
        File::Path::make_path("$sortdir/$block") unless $c->{dry_run};
        my $job = $m->{jobs}[0];
        my $src = "$m->{storage}/sorted-run$job.root";
        if (!$c->{dry_run}) {
            if (!-f $src) {
                TaskLib::task_log($c, $name, "sorted file missing: $src");
                exit 2;
            }
            unlink($sorted) if -e $sorted;
            File::Copy::copy($src, $sorted)
                or die "mu3esort: cannot cp $src -> $sorted: $!\n";
        }
        TaskLib::task_log($c, $name, "sorted file: $sorted");
    },
});

exit($rc == 0 ? 0 : 2);
