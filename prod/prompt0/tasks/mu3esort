#! /usr/bin/perl
# mu3esort — SLURM mu3eSort (processRuns submitJobsRawSort).
# Three jobs per run, no event splitting. Each passes --sort.gsevTriggers:
#   255  random triggers        run{srun}-0xff-sorted.root
#   1    3-hit track triggers   run{srun}-0x01-sorted.root
#   0    128 ns half frames     run{srun}-sorted.root
# Runs from mu3e/run/ inside the tar (alignment ROOT lives there).
use strict;
use warnings;
use File::Basename qw(dirname basename);
use FindBin;
use lib "$FindBin::Bin/..";
use TaskLib;
use SlurmBatch;

my ($run, $ctxfile) = TaskLib::args(@ARGV);
my $ctx = TaskLib::load($ctxfile);
my $name = "mu3esort";

my $file = TaskLib::raw_file($ctx, $run);
my $srun = sprintf("%05d", $run);
my $block = TaskLib::block_dir($run);

# Output under {data_dir}/sort/{workdir}/{block}/.
# block = run/1000 as 3 digits (same as mlzr/trirec).
my $sortdir = $ctx->{sort_dir} // "";
my @streams = (
    { triggers => 255, tag => "0xff" },
    { triggers => 1,   tag => "0x01" },
    { triggers => 0,   tag => "" },
);
for my $s (@streams) {
    my $base = ($s->{tag} ne "")
        ? "run$srun-$s->{tag}-sorted.root"
        : "run$srun-sorted.root";
    $s->{out} = ($sortdir ne "") ? "$sortdir/$block/$base" : "";
}

if (!-f $file && !$ctx->{dry_run}) {
    TaskLib::task_log($ctx, $name, "raw file missing: $file");
    exit 2;
}

if (!$ctx->{force}) {
    my @missing = grep { $_->{out} eq "" || !-f $_->{out} } @streams;
    if (!@missing) {
        TaskLib::task_log($ctx, $name, "sorted files already exist, skipping");
        exit 0;
    }
}

my $storage1 = "$ctx->{root}/slurm/storage1/sort";
my $datadir  = dirname($file);
my $midas    = basename($file);

# conf file selection: prefer sort_conf from cfg, else default beam conf.
my $anlzr = $ctx->{sort_anlzr}
    // "--alignment.file=mu3e_alignment.root --conf trirec_threelayer_beam.conf ";
$anlzr =~ s/\s+$//;

my $rc = SlurmBatch::run($ctx, {
    name    => $name,
    stage   => "sort",
    abbr    => "s",
    wrapper => $ctx->{slurm_sort_csh},
    njobs   => scalar @streams,
    env     => [
        [ STORAGE1  => $storage1 ],
        [ DATADIR   => $datadir ],
        [ MIDASFILE => $midas ],
        [ RUN       => $run ],
        [ GT        => $ctx->{cdb_GT} ],
    ],
    job_env => sub {
        my ($j) = @_;
        my $s = $streams[$j->{i}];
        return [
            [ ANLZR => "$anlzr --sort.gsevTriggers=$s->{triggers}" ],
            [ SORTEDFILE => "sorted-run$j->{job}.root" ],
        ];
    },
    merge => sub {
        my ($c, $m) = @_;
        return if $sortdir eq "";
        require File::Path;
        require File::Copy;
        File::Path::make_path("$sortdir/$block") unless $c->{dry_run};
        for (my $i = 0; $i < @streams; $i++) {
            my $s = $streams[$i];
            my $job = $m->{jobs}[$i];
            my $src = "$m->{storage}/sorted-run$job.root";
            my $dst = $s->{out};
            if (!$c->{dry_run}) {
                if (!-f $src) {
                    TaskLib::task_log($c, $name, "sorted file missing: $src");
                    exit 2;
                }
                unlink($dst) if -e $dst;
                File::Copy::copy($src, $dst)
                    or die "mu3esort: cannot cp $src -> $dst: $!\n";
            }
            TaskLib::task_log($c, $name,
                "sorted file (gsevTriggers=$s->{triggers}): $dst");
        }
    },
});

exit($rc == 0 ? 0 : 2);
