#! /usr/bin/perl
# minalyzer — SLURM minalyzer over the raw file (processRuns submitJobsRawMinalyzer).
# Jobs cover the run in steps of minalyzer_n_events. Each job analyzes the
# first minalyzer_prescale fraction of its step (-s skip -e take).
use strict;
use warnings;
use File::Basename qw(dirname basename);
use FindBin;
use lib "$FindBin::Bin/..";
use TaskLib;
use SlurmBatch;

my ($run, $ctxfile) = TaskLib::args(@ARGV);
my $ctx = TaskLib::load($ctxfile);
my $name = "minalyzer";

my $file = TaskLib::raw_file($ctx, $run);
my $srun = sprintf("%05d", $run);
my $block = TaskLib::block_dir($run);
my $mlzr = $ctx->{mlzr_dir} // "";
my $merged = ($mlzr ne "") ? "$mlzr/$block/dqm_histos_$srun.root" : "";

my $total = $ctx->{n_events};
if (!defined $total || $total eq "") {
    $total = TaskLib::rdb_events($ctx, $run);
    TaskLib::ctx_set($ctxfile, n_events => $total);
}
my $chunk = 0 + ($ctx->{minalyzer_n_events} // 2000);
my $prescale = 0 + ($ctx->{minalyzer_prescale} // 1);
$prescale = 1 if $prescale <= 0 || $prescale > 1;
my $take = $chunk;
if ($prescale < 1 && $chunk > 0) {
    $take = int($chunk * $prescale + 1e-9);
    $take = 1 if $take < 1;
}
TaskLib::task_log($ctx, $name, "chunk=$chunk prescale=$prescale take=$take");

if (!-f $file && !$ctx->{dry_run}) {
    TaskLib::task_log($ctx, $name, "raw file missing: $file");
    exit 2;
}

my $storage1 = "$ctx->{root}/slurm/storage1/mlzr";
my $datadir  = dirname($file);
my $midas    = basename($file);

my $rc = SlurmBatch::run($ctx, {
    name    => $name,
    stage   => "mlzr",
    abbr    => "m",
    wrapper => $ctx->{slurm_analyzer_csh},
    total   => $total,
    chunk   => $chunk,
    skip_if => $merged,
    env     => [
        [ STORAGE1 => $storage1 ],
        [ DATADIR  => $datadir ],
        [ MIDASFILE => $midas ],
        [ RUN      => $run ],
        [ GT       => $ctx->{cdb_GT} ],
    ],
    job_env => sub {
        my ($j) = @_;
        my $anl;
        if ($prescale >= 1 && $j->{last}) {
            $anl = "-s$j->{skip}";
        } else {
            my $n = $take;
            if ($j->{last} && $total > $j->{skip}) {
                my $remain = $total - $j->{skip};
                $n = $remain if $remain < $n;
            }
            $anl = "-s$j->{skip} -e$n";
        }
        return [ [ ANLZR => $anl ] ];
    },
    merge => sub {
        my ($c, $m) = @_;
        return if $merged eq "";
        my @in;
        for my $job (@{ $m->{jobs} }) {
            push @in, "$m->{storage}/root_output_files_$job/dqm_histos_$m->{srun}.root";
        }
        SlurmBatch::hadd($c, $name, $merged, @in) or exit 2;
    },
});

exit($rc == 0 ? 0 : 2);
