#! /usr/bin/perl
# mu3ecor26 — SLURM mu3eCor26, one job per run (no event splitting).
#
# The job runs in the mu3eana checkout. mu3eCor26 prefixes results/ itself:
#   _build/sfh/Correlations/mu3eCor26 <sorted.root> results-$RUN -1
#   results/results-$RUN/results-$RUN.pdf
# After the job, that PDF is uploaded to the RDB (description=cor26),
# replacing every earlier cor26 PDF for the run. comment is prompt_workdir.
use strict;
use warnings;
use JSON::PP qw(encode_json);
use FindBin;
use lib "$FindBin::Bin/..";
use TaskLib;
use SlurmBatch;

my ($run, $ctxfile) = TaskLib::args(@ARGV);
my $ctx = TaskLib::load($ctxfile);
my $name = "mu3ecor26";

my $srun = sprintf("%05d", $run);
my $block = TaskLib::block_dir($run);
my $sortdir = $ctx->{sort_dir} // "";
my $sorted = ($sortdir ne "") ? "$sortdir/$block/run$srun-sorted.root" : "";

my $rundir = $ctx->{mu3eana} // "";
my $exe = ($rundir ne "") ? "$rundir/_build/sfh/Correlations/mu3eCor26" : "";
my $resname = "results-$run";
my $pdf = ($rundir ne "") ? "$rundir/results/$resname/$resname.pdf" : "";

my $rdb = $ctx->{rdb_url} // "";
$rdb =~ s{/+$}{};

if (!$ctx->{dry_run}) {
    if ($rundir eq "" || !-d $rundir) {
        TaskLib::task_log($ctx, $name, "mu3eana missing: $rundir");
        exit 2;
    }
    if (!-x $exe && !-f $exe) {
        TaskLib::task_log($ctx, $name, "mu3eCor26 not found: $exe");
        exit 2;
    }
    if ($sorted eq "" || !-f $sorted) {
        TaskLib::task_log($ctx, $name, "sorted ROOT missing: $sorted");
        exit 2;
    }
    if ($rdb eq "") {
        TaskLib::task_log($ctx, $name, "rdb_url empty; cannot upload the PDF");
        exit 2;
    }
}

my $storage1 = "$ctx->{root}/slurm/storage1/cor26";

my $rc = SlurmBatch::run($ctx, {
    name    => $name,
    stage   => "cor26",
    abbr    => "c",
    wrapper => $ctx->{slurm_cor26_csh},
    njobs   => 1,
    skip_if => $pdf,
    env     => [
        [ STORAGE1   => $storage1 ],
        [ MU3EANA    => $rundir ],
        [ EXE        => $exe ],
        [ SORTEDFILE => $sorted ],
        [ RESNAME    => $resname ],
        [ RUN        => $run ],
    ],
    merge => sub {
        my ($c, $m) = @_;
        my $src = "$m->{storage}/$resname.pdf";
        if (!$c->{dry_run} && !-f $src) {
            TaskLib::task_log($c, $name, "PDF missing: $src");
            exit 2;
        }
        if (!$c->{dry_run} && !-f $pdf) {
            TaskLib::task_log($c, $name, "PDF missing: $pdf");
            exit 2;
        }
        TaskLib::task_log($c, $name, "pdf=$pdf");
        _upload($c, $name, $rdb, $run, $pdf);
    },
});

exit($rc == 0 ? 0 : 2);

# ----------------------------------------------------------------------
sub _upload {
    my ($c, $name, $rdb, $run, $pdf) = @_;
    if ($rdb eq "") {
        TaskLib::task_log($c, $name, "rdb_url empty; PDF would not be uploaded");
        exit 2 unless $c->{dry_run};
        return;
    }
    my $comment = $c->{workdir} // "";
    my $rm_json = encode_json({description => "cor26"});

    if ($c->{dry_run}) {
        TaskLib::task_log($c, $name,
            "would: curl -fsS -X PUT -H Content-Type: application/json"
            . " --data $rm_json $rdb/removeResources/$run");
        TaskLib::task_log($c, $name,
            "would: curl -fsS -X POST -F pdf=\@$pdf"
            . " -F description=cor26"
            . (($c->{workdir} // "") ne "" ? " -F comment=$c->{workdir}" : "")
            . " $rdb/addResource/$run");
        return;
    }

    my $rm = system(
        "curl", "-fsS", "-X", "PUT",
        "-H", "Content-Type: application/json",
        "--data", $rm_json,
        "$rdb/removeResources/$run",
    );
    if ($rm != 0) {
        TaskLib::task_log($c, $name, "removeResources description=cor26 failed");
        exit 2;
    }

    TaskLib::task_log($c, $name, "upload $pdf description=cor26"
        . ($comment ne "" ? " comment=$comment" : "")
        . " $rdb/addResource/$run");
    my @up = (
        "curl", "-fsS", "-X", "POST",
        "-F", "pdf=\@$pdf",
        "-F", "description=cor26",
    );
    push @up, "-F", "comment=$comment" if $comment ne "";
    push @up, "$rdb/addResource/$run";
    my $up = system(@up);
    exit 2 if $up != 0;
}
