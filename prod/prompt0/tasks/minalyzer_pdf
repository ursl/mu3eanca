#! /usr/bin/perl
# minalyzer_pdf — plots from the minalyzer ROOT directory (dqm_pdf Minalyzer_pdf).
#
#   Minalyzer_pdf --dqm-dir MLZR/BLOCK --run RUN \
#       --output-dir output --csv-dir csv --data-dir RAW/BLOCK
#
# Login node (not SLURM). cwd is minalyzer_pdf_rundir. output/ and csv/
# are created there before the executable runs. The PDF written into
# output/ is uploaded to rdb_url (mu3edb0 on merlin) as description=dqm,
# replacing any earlier resource with that description.
use strict;
use warnings;
use Cwd qw(getcwd);
use File::Path qw(make_path);
use FindBin;
use lib "$FindBin::Bin/..";
use TaskLib;

my ($run, $ctxfile) = TaskLib::args(@ARGV);
my $ctx = TaskLib::load($ctxfile);
my $name = "minalyzer_pdf";

my $block = TaskLib::block_dir($run);
my $mlzr = $ctx->{mlzr_dir} // "";
my $dqmdir = ($mlzr ne "") ? "$mlzr/$block" : "";

my $raw = $ctx->{raw_dir} // "";
my $layout = $ctx->{raw_input_layout} // "runblock3";
my $datadir = $raw;
$datadir = "$raw/$block" if $raw ne "" && $layout ne "flat";

my $rundir = TaskLib::resolve_path($ctx, $ctx->{minalyzer_pdf_rundir} // "", "");
my $rel = $ctx->{minalyzer_pdf_bin} // "_build/Minalyzer_pdf";
my $exe = TaskLib::resolve_path($ctx, $rel, $rundir);

my @cmd = (
    $exe,
    "--dqm-dir", $dqmdir,
    "--run", $run,
    "--output-dir", "output",
    "--csv-dir", "csv",
    "--data-dir", $datadir,
);

my $rdb = $ctx->{rdb_url} // "";
$rdb =~ s{/+$}{};

if ($ctx->{dry_run}) {
    TaskLib::task_log($ctx, $name, "would: mkdir $rundir/output $rundir/csv");
    TaskLib::task_log($ctx, $name, "would: (cd $rundir && @cmd)");
    if ($rdb eq "") {
        TaskLib::task_log($ctx, $name, "rdb_url empty; PDF would not be uploaded");
    } else {
        TaskLib::task_log($ctx, $name,
            "would: curl -fsS -X PUT -H Content-Type: application/json"
            . " --data {\"description\":\"dqm\"} $rdb/removeResources/$run");
        TaskLib::task_log($ctx, $name,
            "would: curl -fsS -X POST -F pdf=\@$rundir/output/<pdf>"
            . " -F description=dqm $rdb/addResource/$run");
    }
    exit 0;
}

if ($rundir eq "" || !-d $rundir) {
    TaskLib::task_log($ctx, $name, "rundir missing: $rundir");
    exit 2;
}
if (!-x $exe && !-f $exe) {
    TaskLib::task_log($ctx, $name, "Minalyzer_pdf not found: $exe");
    exit 2;
}
if ($dqmdir eq "" || !-d $dqmdir) {
    TaskLib::task_log($ctx, $name, "dqm dir missing: $dqmdir");
    exit 2;
}
if ($datadir eq "" || !-d $datadir) {
    TaskLib::task_log($ctx, $name, "data dir missing: $datadir");
    exit 2;
}

for my $d (qw(output csv)) {
    make_path("$rundir/$d");
}

if ($rdb eq "") {
    TaskLib::task_log($ctx, $name, "rdb_url empty; cannot upload the PDF");
    exit 2;
}

my $started = time();
my $cwd = getcwd();
chdir($rundir) or die "minalyzer_pdf: cannot chdir $rundir: $!\n";

TaskLib::task_log($ctx, $name, "cwd=$rundir");
TaskLib::task_log($ctx, $name, "@cmd");
my $rc = system(@cmd);

chdir($cwd) or die "minalyzer_pdf: cannot chdir back to $cwd: $!\n";
if ($rc != 0) {
    exit 2;
}

my $pdf = _result_pdf("$rundir/output", $run, $started);
if ($pdf eq "") {
    TaskLib::task_log($ctx, $name, "no PDF written in $rundir/output");
    exit 2;
}

my $rm = system(
    "curl", "-fsS", "-X", "PUT",
    "-H", "Content-Type: application/json",
    "--data", '{"description":"dqm"}',
    "$rdb/removeResources/$run",
);
if ($rm != 0) {
    TaskLib::task_log($ctx, $name, "removeResources description=dqm failed");
    exit 2;
}

TaskLib::task_log($ctx, $name, "upload $pdf description=dqm $rdb/addResource/$run");
my $up = system(
    "curl", "-fsS", "-X", "POST",
    "-F", "pdf=\@$pdf",
    "-F", "description=dqm",
    "$rdb/addResource/$run",
);
exit($up == 0 ? 0 : 2);

# Newest PDF written by this run. Prefer a name that contains the run number.
sub _result_pdf {
    my ($dir, $run, $since) = @_;
    opendir my $dh, $dir or return "";
    my @names = readdir $dh;
    closedir $dh;
    my $srun = sprintf("%05d", $run);
    my @fresh;
    for my $n (@names) {
        next unless $n =~ /\.pdf$/i;
        my $path = "$dir/$n";
        next unless -f $path;
        my $mtime = (stat($path))[9] // 0;
        push @fresh, $path if $mtime >= $since;
    }
    return "" unless @fresh;
    my @hit = grep { /$srun/ || /(?:^|[^0-9])$run(?:[^0-9]|$)/ } @fresh;
    my @pick = @hit ? @hit : @fresh;
    @pick = sort { ((stat($b))[9] // 0) <=> ((stat($a))[9] // 0) } @pick;
    return $pick[0];
}
