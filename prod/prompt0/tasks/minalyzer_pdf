#! /usr/bin/perl
# minalyzer_pdf — plots from the merged minalyzer ROOT (mu3eana Minalyzer_pdf).
#
#   Minalyzer_pdf DIR RUN pdf
#   opens DIR/dqm_histos_XXXXX.root
#
# Runs on the login node (not SLURM), cwd = the Minalyzer_pdf dir
# (textpos.sty and other local TeX files live there).
use strict;
use warnings;
use Cwd qw(getcwd);
use File::Basename qw(dirname);
use FindBin;
use lib "$FindBin::Bin/..";
use TaskLib;

my ($run, $ctxfile) = TaskLib::args(@ARGV);
my $ctx = TaskLib::load($ctxfile);
my $name = "minalyzer_pdf";

my $srun = sprintf("%05d", $run);
my $block = TaskLib::block_dir($run);
my $mlzr = $ctx->{mlzr_dir} // "";
my $dir = ($mlzr ne "") ? "$mlzr/$block" : "";
my $merged = ($dir ne "") ? "$dir/merged-dqm_histos_$srun.root" : "";
my $dqm = ($dir ne "") ? "$dir/dqm_histos_$srun.root" : "";

my $ana = $ctx->{mu3eana} // "";
my $rel = $ctx->{minalyzer_pdf_bin} // "_build/UCL/Minalyzer_pdf/Minalyzer_pdf";
my $exe = ($rel =~ m{^/}) ? $rel : (($ana ne "") ? "$ana/$rel" : $rel);
my $mode = $ctx->{minalyzer_pdf_mode} // "pdf";
my $pdfdir = dirname($exe);

if ($ctx->{dry_run}) {
    TaskLib::task_log($ctx, $name, "would: (cd $pdfdir && $exe $dir $run $mode)");
    exit 0;
}

if ($ana eq "") {
    TaskLib::task_log($ctx, $name,
        "mu3eana checkout missing in ctx (add [repo] id: mu3eana and ./prompt setup)");
    exit 2;
}
if (!-x $exe && !-f $exe) {
    TaskLib::task_log($ctx, $name, "Minalyzer_pdf not found: $exe");
    exit 2;
}
if ($dir eq "") {
    TaskLib::task_log($ctx, $name, "mlzr_dir empty in ctx");
    exit 2;
}
if (!-e $dqm) {
    if (!-f $merged) {
        TaskLib::task_log($ctx, $name, "merged ROOT missing: $merged");
        exit 2;
    }
    # hadd writes merged-dqm_histos_XXXXX.root; the pdf tool opens dqm_histos_XXXXX.root
    unlink($dqm) if -l $dqm;
    if (!symlink("merged-dqm_histos_$srun.root", $dqm)) {
        TaskLib::task_log($ctx, $name, "cannot symlink $dqm -> merged-dqm_histos_$srun.root: $!");
        exit 2;
    }
    TaskLib::task_log($ctx, $name, "symlink $dqm -> merged-dqm_histos_$srun.root");
}

my $cwd = getcwd();
chdir($pdfdir) or die "minalyzer_pdf: cannot chdir $pdfdir: $!\n";

TaskLib::task_log($ctx, $name, "cwd=$pdfdir");
TaskLib::task_log($ctx, $name, "$exe $dir $run $mode");
my $rc = system($exe, $dir, $run, $mode);

chdir($cwd) or die "minalyzer_pdf: cannot chdir back to $cwd: $!\n";

exit(($rc == 0) ? 0 : 2);
