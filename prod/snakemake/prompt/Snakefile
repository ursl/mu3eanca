CDB_UPDATE_SCRIPT = str(_PROD_COMMON / "scripts" / "run_cdb_update")
MINALYZER_SCRIPT = str(_PROD_COMMON / "scripts" / "run_minalyzer")
POST_PROCESS_SCRIPT = str(_PROD_COMMON / "scripts" / "run_post_process")

JOB_SUBMIT_MODE = config.get("job_submit_mode", "local")
