#! /usr/bin/perl

# ----------------------------------------------------------------------
# startGT — bootstrap local test-CDB global tags (mcideal / mcrealistic / data)
#
#   ./startGT setup
#   ./startGT sim                              # one mcideal alignment ROOT
#   ./startGT -g mcidealv7.1 alignment
#   ./startGT -g 'mcrealisticv7.1=2026V0' alignment
#   ./startGT -g 'datav7.1=2026V0' alignment
#   ./startGT -g mcidealv7.1 quality
#   ./startGT -g mcidealv7.1 alltags            # alignment + quality in one go
#
# GT names with '=' — quote: -g 'datav7.1=2026V0'
# ----------------------------------------------------------------------

use strict;
use warnings;

use Getopt::Long;
use Pod::Usage;

my $config   = 'GT-v7.1.cfg';
my $help     = 0;
my $host_opt = '';
my $dry_run  = 0;
my $jobs     = undef;
my $GT       = '';

GetOptions(
    'c=s'     => \$config,
    'H=s'     => \$host_opt,
    'j=i'     => \$jobs,
    'n'       => \$dry_run,
    'GT=s'    => \$GT,
    'g=s'     => \$GT,
    'h|help'  => \$help,
) or pod2usage(2);

pod2usage(1) if $help;

use Cwd qw(abs_path);
use File::Basename qw(dirname);

use lib abs_path(dirname($0)) . "/common";
use lib abs_path(dirname($0)) . "/../relval/common";
use RelvalConfig qw(load_config host_name);
use StartGT qw(
    startgt_setup
    startgt_run_mu3esim
    startgt_run_alignment_payloads
    startgt_run_quality_payloads
    startgt_run_alltags
    startgt_status
);

sub prefix {
    my $now = localtime;
    return "$now/startGT        / ";
}

sub usage {
    print <<"END";
Usage: $0 [-c FILE] [-H host] [-n] [-j N] [-g GT] [target]

Targets:
  setup          clone/checkout/build/relink mu3e
  sim            mcideal mu3eSim → single alignment ROOT (shared by all GTs)
  alignment      write alignment payloads (-g GT required)
  quality        write perfect quality payloads, IOV 1 (-g GT required)
  alltags        alignment + quality for one GT (-g GT required); alias: payloads
  status         show paths and build state
  list           print resolved config (default)

Options:
  -c FILE   config file (default: GT-v7.1.cfg)
  -H HOST   host overlay config-HOST.cfg
  -j N      make -jN for mu3e build
  -n        dry-run
  -g GT     global tag, e.g. mcidealv7.1 or datav7.1=2026V0 (quote if '=')
  -h        help
END
    exit(1);
}

sub _opts {
    return (
        dry_run => $dry_run ? 1 : 0,
        jobs    => defined $jobs ? (0 + $jobs) : undef,
        gt      => $GT,
    );
}

sub do_list {
    my ($cfg) = @_;
    print(prefix(), "config ", ($cfg->{_config_path} // ""), "\n");
    for my $key (sort keys %$cfg) {
        next if $key eq "setup_repos" || $key eq "includes" || $key =~ /^_/;
        my $val = $cfg->{$key};
        next unless defined $val;
        next if ref($val);
        print("  $key: $val\n");
    }
}

my $script_dir = abs_path(dirname($0));
chdir($script_dir) or die "Cannot chdir to $script_dir: $!\n";

my $cfg_file = $config;
my $host     = host_name($host_opt);

my $target = "";
for my $a (@ARGV) {
    next if $a =~ /^-/;
    die "startGT: positional argument '$a' looks like a GT name; use -g '$a'\n"
        if $a =~ /^[a-z]/i && $a =~ /=/;
    $target = $a;
    last;
}

if ($target eq "") {
    my $peek = load_config($cfg_file, $host);
    $target = $peek->{target} // $peek->{action} // "list";
    $target =~ s/^\s+|\s+$//g;
}
$target = "list" if $target eq "";

print(prefix(), "config=$cfg_file host=$host target=$target",
    ($GT ne "" ? " GT=$GT" : ""),
    ($dry_run ? " (dry-run)" : ""), "\n");

my $cfg = load_config($cfg_file, $host);
my %opts = _opts();

if ($target eq "setup") {
    startgt_setup($cfg, %opts);
} elsif ($target eq "sim") {
    startgt_run_mu3esim($cfg, %opts);
} elsif ($target eq "alignment") {
    startgt_run_alignment_payloads($cfg, %opts);
} elsif ($target eq "quality") {
    startgt_run_quality_payloads($cfg, %opts);
} elsif ($target eq "alltags" || $target eq "payloads") {
    startgt_run_alltags($cfg, %opts);
} elsif ($target eq "status") {
    startgt_status($cfg, %opts);
} elsif ($target eq "list") {
    do_list($cfg);
} else {
    die "unknown target '$target'\n";
}

print(prefix(), "done\n");
exit(0);
